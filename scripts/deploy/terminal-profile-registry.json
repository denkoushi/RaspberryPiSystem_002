{
  "schemaVersion": 5,
  "terminalProfiles": [
    {"id": "kiosk"},
    {"id": "signage"}
  ],
  "pathMappings": [
    {"match": "prefix", "path": "docs/", "component": "neutral"},
    {"match": "prefix", "path": ".cursor/", "component": "neutral"},
    {"match": "prefix", "path": ".agent/", "component": "neutral"},
    {"match": "prefix", "path": ".github/", "component": "neutral"},
    {"match": "prefix", "path": "e2e/", "component": "neutral"},
    {"match": "prefix", "path": "test-data/", "component": "neutral"},
    {"match": "prefix", "path": "scripts/ci/", "component": "neutral"},
    {"match": "prefix", "path": "scripts/deploy/tests/", "component": "neutral"},
    {"match": "exact", "path": "AGENTS.md", "component": "neutral"},
    {"match": "prefix", "path": "README", "component": "neutral"},
    {"match": "exact", "path": "EXEC_PLAN.md", "component": "neutral"},

    {"match": "exact", "path": ".gitignore", "component": "deploy-control"},
    {"match": "exact", "path": "infrastructure/ansible/ansible-readonly.cfg", "component": "deploy-control"},
    {"match": "exact", "path": "infrastructure/ansible/callback_plugins/rolling_release_timing.py", "component": "deploy-control"},
    {"match": "exact", "path": "scripts/update-all-clients.sh", "component": "deploy-control"},
    {"match": "exact", "path": "scripts/deploy/validate-expand-only-migrations.py", "component": "pi5-control"},
    {"match": "prefix", "path": "scripts/google_drive_dr/", "component": "pi5-control"},
    {"match": "exact", "path": "scripts/deploy/production_config_contract.py", "component": "server-app"},
    {"match": "exact", "path": "scripts/deploy/signage-runtime-proof.py", "component": "signage-role"},
    {"match": "prefix", "path": "scripts/deploy/", "component": "deploy-control"},
    {"match": "prefix", "path": "apps/api/prisma/migrations/", "component": "migration"},
    {"match": "prefix", "path": "apps/api/", "component": "server-app"},
    {"match": "prefix", "path": "apps/web/", "component": "server-app"},
    {"match": "prefix", "path": "packages/", "component": "server-app"},
    {"match": "exact", "path": "infrastructure/docker/Dockerfile.nfc-agent", "component": "nfc-agent"},
    {"match": "exact", "path": "infrastructure/docker/Dockerfile.barcode-agent", "component": "barcode-agent"},
    {"match": "exact", "path": "infrastructure/docker/Dockerfile.torque-agent", "component": "torque-agent"},
    {"match": "prefix", "path": "infrastructure/docker/", "component": "server-app"},
    {"match": "exact", "path": "package.json", "component": "server-app"},
    {"match": "exact", "path": "pnpm-lock.yaml", "component": "server-app"},
    {"match": "exact", "path": "pnpm-workspace.yaml", "component": "server-app"},
    {"match": "prefix", "path": "clients/nfc-agent/", "component": "nfc-agent"},
    {"match": "prefix", "path": "clients/barcode-agent/", "component": "barcode-agent"},
    {"match": "prefix", "path": "clients/torque-agent/", "component": "torque-agent"},
    {"match": "prefix", "path": "clients/status-agent/", "component": "status-agent"},
    {"match": "exact", "path": "infrastructure/ansible/group_vars/server/web-build.yml", "component": "server-app"},
    {"match": "exact", "path": "infrastructure/ansible/group_vars/server/release-artifacts.yml", "component": "server-app"},
    {"match": "exact", "path": "infrastructure/ansible/host_vars/raspberrypi5/release-artifacts.yml", "component": "server-app"},
    {"match": "exact", "path": "infrastructure/ansible/templates/artifact-promotion.json.j2", "component": "server-app"},
    {"match": "exact", "path": "infrastructure/ansible/templates/release-build-contract.json.j2", "component": "server-app"},
    {"match": "exact", "path": "infrastructure/ansible/templates/docker.env.j2", "component": "server-app"},
    {"match": "exact", "path": "infrastructure/ansible/templates/web.env.j2", "component": "server-app"},
    {"match": "exact", "path": "infrastructure/ansible/playbooks/deploy-google-drive-disaster-recovery.yml", "component": "pi5-control"},
    {"match": "exact", "path": "infrastructure/ansible/templates/raspi-google-drive-dr.env.j2", "component": "pi5-control"},
    {"match": "exact", "path": "infrastructure/ansible/templates/raspi-google-drive-dr.service.j2", "component": "pi5-control"},
    {"match": "exact", "path": "infrastructure/ansible/templates/raspi-google-drive-dr.timer.j2", "component": "pi5-control"},
    {"match": "prefix", "path": "infrastructure/ansible/roles/server/", "component": "server-app"},
    {"match": "exact", "path": "infrastructure/ansible/playbooks/manage-app-configs.yml", "component": "server-app"},
    {"match": "exact", "path": "infrastructure/ansible/playbooks/server-config-release.yml", "component": "server-app"},
    {"match": "exact", "path": "infrastructure/ansible/playbooks/render-release-build-contract.yml", "component": "server-app"},
    {"match": "prefix", "path": "infrastructure/ansible/roles/common/", "component": "global"},
    {"match": "prefix", "path": "infrastructure/ansible/roles/kiosk/", "component": "kiosk-role"},
    {"match": "prefix", "path": "infrastructure/ansible/roles/client/tasks/nfc-agent", "component": "nfc-agent"},
    {"match": "prefix", "path": "infrastructure/ansible/roles/client/tasks/barcode-agent", "component": "barcode-agent"},
    {"match": "prefix", "path": "infrastructure/ansible/roles/client/tasks/torque-agent", "component": "torque-agent"},
    {"match": "prefix", "path": "infrastructure/ansible/roles/client/templates/torque-", "component": "torque-agent"},
    {"match": "exact", "path": "infrastructure/ansible/roles/client/files/torque-bluetooth-guard.py", "component": "torque-agent"},
    {"match": "exact", "path": "infrastructure/ansible/roles/client/templates/90-torque-bluetooth-adapter.rules.j2", "component": "torque-agent"},
    {"match": "exact", "path": "infrastructure/ansible/roles/client/templates/99-torque-wrench-hid.rules.j2", "component": "torque-agent"},
    {"match": "prefix", "path": "infrastructure/ansible/roles/client/", "component": "client-role"},
    {"match": "prefix", "path": "infrastructure/ansible/roles/signage/", "component": "signage-role"},
    {"match": "prefix", "path": "infrastructure/ansible/templates/signage", "component": "signage-role"},
    {"match": "exact", "path": "infrastructure/ansible/templates/nfc-agent.env.j2", "component": "nfc-agent"},
    {"match": "exact", "path": "infrastructure/ansible/templates/barcode-agent.env.j2", "component": "barcode-agent"},
    {"match": "exact", "path": "infrastructure/ansible/templates/torque-agent.env.j2", "component": "torque-agent"},
    {"match": "exact", "path": "infrastructure/ansible/tasks/preflight-signage.yml", "component": "signage-role"},
    {"match": "prefix", "path": "infrastructure/ansible/playbooks/", "component": "global"},
    {"match": "prefix", "path": "infrastructure/ansible/group_vars/", "component": "global"},
    {"match": "prefix", "path": "infrastructure/ansible/inventory", "component": "global"}
  ],
  "componentProfiles": {
    "neutral": [],
    "deploy-control": [],
    "pi5-control": [],
    "migration": [],
    "server-app": [],
    "nfc-agent": ["kiosk"],
    "barcode-agent": ["kiosk"],
    "torque-agent": ["kiosk"],
    "status-agent": ["kiosk", "signage"],
    "kiosk-role": ["kiosk"],
    "client-role": ["kiosk", "signage"],
    "signage-role": ["signage"],
    "global": ["kiosk", "signage"]
  },
  "componentHostSelectors": {
    "nfc-agent": {"hostVar": "nfc_agent_client_id", "match": "non-empty-string"},
    "barcode-agent": {"hostVar": "barcode_agent_enabled", "match": "true"},
    "torque-agent": {"hostVar": "torque_agent_enabled", "match": "true"}
  },
  "clientAgents": {
    "nfc-agent": {
      "composeService": "nfc-agent",
      "runtimeEnvPath": "/opt/RaspberryPiSystem_002/clients/nfc-agent/.env",
      "envTemplate": "infrastructure/ansible/templates/nfc-agent.env.j2",
      "portPolicy": "fixed",
      "defaultPort": 7071,
      "portEnvironment": "REST_PORT",
      "healthEndpoint": "/api/agent/status",
      "responseValidator": "nfc-agent-status-v1",
      "component": "nfc-agent",
      "hostSelector": {"hostVar": "nfc_agent_client_id", "match": "non-empty-string"}
    },
    "barcode-agent": {
      "composeService": "barcode-agent",
      "runtimeEnvPath": "/opt/RaspberryPiSystem_002/clients/barcode-agent/.env",
      "envTemplate": "infrastructure/ansible/templates/barcode-agent.env.j2",
      "portPolicy": "configurable",
      "defaultPort": 7072,
      "portEnvironment": "REST_PORT",
      "healthEndpoint": "/api/agent/status",
      "responseValidator": "barcode-agent-status-v1",
      "component": "barcode-agent",
      "hostSelector": {"hostVar": "barcode_agent_enabled", "match": "true"}
    },
    "torque-agent": {
      "composeService": "torque-agent",
      "runtimeEnvPath": "/opt/RaspberryPiSystem_002/clients/torque-agent/.env",
      "envTemplate": "infrastructure/ansible/templates/torque-agent.env.j2",
      "portPolicy": "fixed",
      "defaultPort": 7073,
      "portEnvironment": "TORQUE_LOCAL_PORT",
      "healthEndpoint": "/health",
      "responseValidator": "torque-agent-health-v1",
      "component": "torque-agent",
      "hostSelector": {"hostVar": "torque_agent_enabled", "match": "true"}
    }
  }
}
