# Image for embedding-server.py with EMBEDDING_BACKEND=embeddinggemma2 (CPU).
# lmsysorg/sglang:latest carries transformers 5.3.0 and no sentence-transformers, so it cannot load
# google/embeddinggemma-2. Versions below are the ones measured on the DGX on 2026-10-07.
FROM python:3.12-slim
RUN pip install --no-cache-dir torch==2.14.1 torchvision==0.29.1 --index-url https://download.pytorch.org/whl/cpu \
 && pip install --no-cache-dir sentence-transformers==6.1.0 transformers==5.19.0 pillow==12.3.0
