# /srv/dgx/system-prod/etc/embedding-server.env として置く（EmbeddingGemma 2、ADR-20261007）。
# Pi5 の PHOTO_TOOL_EMBEDDING_MODEL_ID / PHOTO_TOOL_EMBEDDING_DIMENSION と一致させること。
EMBEDDING_SERVER_IMAGE=system-prod-embedding-eg2:20261007
EMBEDDING_BACKEND=embeddinggemma2
EMBEDDING_HF_MODEL=google/embeddinggemma-2
EMBEDDING_MODEL_ID=embeddinggemma-2-512d
EMBEDDING_TRUNCATE_DIM=512
EMBEDDING_DEVICE=cpu
