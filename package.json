{
  "name": "raspberry-pi-system",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "husky install || true",
    "dev": "echo '各アプリの dev コマンドを使用してください'",
    "build": "echo 'ワークスペース個別に build を実行してください'",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:api": "bash scripts/test/run-tests.sh",
    "test:backup": "bash scripts/test/backup-restore.test.sh",
    "test:monitor": "bash scripts/test/monitor.test.sh",
    "test:deploy-contracts": "bash scripts/ci/run-deploy-contracts-local.sh",
    "test:e2e": "playwright test",
    "test:e2e:runtime-recovery": "playwright test --config=playwright.runtime-recovery.config.ts",
    "test:e2e:smoke": "playwright test e2e/smoke --workers=1 --retries=1",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "kiosk-sop:generate": "bash scripts/kiosk-sop/run-in-docker.sh generate",
    "kiosk-sop:check": "bash scripts/kiosk-sop/run-in-docker.sh check",
    "kiosk-sop:source-check": "node scripts/kiosk-sop/source-digest.mjs check",
    "kiosk-sop:source-refresh": "node scripts/kiosk-sop/source-digest.mjs refresh",
    "kiosk-sop:test": "pnpm --filter @raspi-system/kiosk-sop-core test && playwright test e2e/inspection-drawing-sop-popup.spec.ts",
    "test:postgres:start": "bash scripts/test/start-postgres.sh",
    "test:postgres:stop": "bash scripts/test/stop-postgres.sh",
    "preview:signage-compact24": "python3 -m http.server 8765 --directory apps/api/scripts/html-previews",
    "preview:html-previews": "python3 -m http.server 8765 --directory apps/api/scripts/html-previews"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": "10.34.6"
  },
  "packageManager": "pnpm@10.34.6",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "husky": "^9.1.7",
    "pixelmatch": "8.0.0",
    "playwright": "^1.64.1",
    "pngjs": "7.0.0"
  },
  "pnpm": {
    "overrides": {
      "glob": "10.5.0",
      "minimatch": "10.2.3",
      "fast-uri": "3.1.8",
      "dompurify@3.4.11": "3.4.17",
      "zod": "4.6.6"
    },
    "patchedDependencies": {
      "@a2ui/web_core@0.11.0": "patches/@a2ui__web_core@0.11.0.patch"
    }
  },
  "dependencies": {
    "node-cron": "^4.6.0"
  }
}
