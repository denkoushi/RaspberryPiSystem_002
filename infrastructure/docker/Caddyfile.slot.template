# Private Web slot. The fixed gateway is the only process that publishes 80/443.
{
  auto_https off
}

:80 {
  encode zstd gzip

  @internal_deploy_readiness path /api/system/deploy-readiness/internal
  respond @internal_deploy_readiness 404

  root * /srv/site

  @api {
    path /api/* /ws/*
  }
  reverse_proxy @api ${SLOT_API_UPSTREAM} {
    header_up X-Forwarded-For {remote_host}
    transport http {
      versions 1.1
    }
  }

  handle /storage/thumbnails/* {
    uri replace /storage/thumbnails/ /api/storage/thumbnails/
    reverse_proxy ${SLOT_API_UPSTREAM} {
      header_up X-Forwarded-For {remote_host}
    }
  }

  @static_site {
    not path /api/* /ws/* /storage/*
  }
  route @static_site {
    @spa {
      not path /assets/*
      not file
    }
    rewrite @spa /index.html

    # HTML is always revalidated so an old entrypoint cannot reference a removed chunk.
    @document path / /index.html
    header @document Cache-Control "no-store, no-cache, must-revalidate"

    @service_worker path /sw.js
    header @service_worker Cache-Control "no-cache"

    @hashed_asset {
      path_regexp ^/assets/.+-[A-Za-z0-9_-]{8}\.(js|css|woff2?)$
      file
    }
    header @hashed_asset Cache-Control "public, max-age=31536000, immutable"

    file_server
  }

  header {
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "strict-origin-when-cross-origin"
  }

  log {
    output file /var/log/caddy/access.log {
      roll_size 5MiB
      roll_keep 300
      roll_keep_for 168h
    }
  }
}
