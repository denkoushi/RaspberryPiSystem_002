# syntax=docker/dockerfile:1

FROM node:20-bookworm-slim AS workspace
WORKDIR /app
ENV NODE_OPTIONS=--max-old-space-size=4096

RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl \
  && rm -rf /var/lib/apt/lists/*

# Workspace manifests only: source copies after install so ordinary app changes reuse install cache.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY apps/api/package.json ./apps/api/package.json
COPY packages/shared-types/package.json ./packages/shared-types/package.json
COPY packages/part-search-core/package.json ./packages/part-search-core/package.json
COPY packages/shelf-layout-core/package.json ./packages/shelf-layout-core/package.json

RUN --mount=type=cache,id=raspi-pnpm-store,target=/pnpm/store,sharing=locked \
  corepack enable \
  && npm_config_fetch_retries=5 \
    npm_config_fetch_retry_factor=1 \
    npm_config_fetch_retry_mintimeout=2000 \
    npm_config_fetch_retry_maxtimeout=5000 \
    npm_config_fetch_timeout=30000 \
    pnpm install --filter @raspi-system/api... --frozen-lockfile \
      --store-dir=/pnpm/store --network-concurrency=4

FROM workspace AS build

COPY apps/api ./apps/api
COPY packages ./packages
# Keep the runtime script boundary explicit so deploy tests and fixtures do not
# invalidate or enter the API image.
COPY scripts/deploy/deploy-status-state.py ./scripts/deploy/deploy-status-state.py
COPY scripts/part-measurement/drawing-local-rapidocr-worker.py ./scripts/part-measurement/drawing-local-rapidocr-worker.py
COPY scripts/server/add-cert-backup-target.mjs ./scripts/server/add-cert-backup-target.mjs

WORKDIR /app/packages/shared-types
RUN nice -n 10 pnpm build

WORKDIR /app/packages/part-search-core
RUN nice -n 10 pnpm build

WORKDIR /app/packages/shelf-layout-core
RUN nice -n 10 pnpm build

WORKDIR /app/apps/api
RUN nice -n 10 pnpm prisma generate
RUN nice -n 10 pnpm run build

FROM node:20-bookworm-slim AS api-runtime
WORKDIR /app
ARG NDLOCR_LITE_COMMIT=89f815899f0e85d236a1a90e75da012ca932dc7b
# Bump the date to invalidate the cached apt layer; otherwise the CI build
# cache keeps stale OS packages and Trivy fails on already-fixed Debian CVEs.
ARG APT_CACHE_BUST=2026-08-18

RUN echo "apt refresh ${APT_CACHE_BUST}" \
  && apt-get update \
  && apt-get install -y --no-install-recommends openssl poppler-utils fontconfig fonts-noto-cjk postgresql-client ansible-core python3 python3-pip git \
    libgomp1 libgl1 libglib2.0-0 libsm6 libxext6 \
    libnss3 libnspr4 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 libxkbcommon0 libxcomposite1 libxdamage1 libxfixes3 libxrandr2 libgbm1 libasound2 libpango-1.0-0 \
  && apt-get install -y --only-upgrade --no-install-recommends libgnutls30 libpq5 postgresql-client-15 \
  && for package in libpq5 postgresql-client-15; do \
    installed_version="$(dpkg-query -W -f='${Version}' "${package}")"; \
    dpkg --compare-versions "${installed_version}" ge '15.19-0+deb12u1' \
      || { echo "${package} is below the required fixed version: ${installed_version}" >&2; exit 1; }; \
  done \
  && gnutls_version="$(dpkg-query -W -f='${Version}' libgnutls30)" \
  && dpkg --compare-versions "${gnutls_version}" ge '3.7.9-2+deb12u7' \
    || { echo "libgnutls30 is below the required fixed version: ${gnutls_version}" >&2; exit 1; } \
  && python3 -m pip install --no-cache-dir --break-system-packages \
  "git+https://github.com/ndl-lab/ndlocr-lite.git@${NDLOCR_LITE_COMMIT}" \
  && python3 -m pip install --no-cache-dir --break-system-packages "protobuf>=6.33.5,<7" "pillow>=12.2.0,<13" "lxml>=6.1.0,<7" \
  && python3 -m pip install --no-cache-dir --break-system-packages "rapidocr==3.8.4" "onnxruntime==1.20.1" \
  && command -v ndlocr-lite \
  && ndlocr-lite --help >/dev/null \
  && python3 -c "from rapidocr import RapidOCR; print('rapidocr-ok')" \
  && apt-get purge -y git python3-pip \
  && apt-get autoremove -y \
  && rm -rf /var/lib/apt/lists/*

# Manifests + prod install + Chromium before build artifacts: avoids invalidating heavy layers on API source changes.
COPY --from=workspace /app/package.json ./package.json
COPY --from=workspace /app/pnpm-lock.yaml ./pnpm-lock.yaml
COPY --from=workspace /app/pnpm-workspace.yaml ./pnpm-workspace.yaml
COPY --from=workspace /app/apps/api/package.json ./apps/api/package.json
COPY --from=workspace /app/packages/shared-types/package.json ./packages/shared-types/package.json
COPY --from=workspace /app/packages/part-search-core/package.json ./packages/part-search-core/package.json
COPY --from=workspace /app/packages/shelf-layout-core/package.json ./packages/shelf-layout-core/package.json
WORKDIR /app
RUN --mount=type=cache,id=raspi-pnpm-store,target=/pnpm/store,sharing=locked \
  corepack enable \
  && npm_config_fetch_retries=5 \
    npm_config_fetch_retry_factor=1 \
    npm_config_fetch_retry_mintimeout=2000 \
    npm_config_fetch_retry_maxtimeout=5000 \
    npm_config_fetch_timeout=30000 \
    pnpm install --prod --filter @raspi-system/api... --frozen-lockfile \
      --store-dir=/pnpm/store --network-concurrency=4

# Chromium for Playwright (signage playwright_html, kiosk document HTML→PDF; bundled browser).
# prod install 後に実行（playwright パッケージが node_modules に入った後）。
# false にするとビルド時間短縮になるが、上記 Playwright 依存機能は実行時に失敗する（起動ログ / GET /api/system/health checks.playwright で検知）。
ARG INSTALL_PLAYWRIGHT_CHROMIUM=true
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN case "${INSTALL_PLAYWRIGHT_CHROMIUM}" in \
    true|1|yes) pnpm --filter @raspi-system/api exec playwright install --only-shell chromium ;; \
    *) echo "Skipping Playwright Chromium install (INSTALL_PLAYWRIGHT_CHROMIUM=${INSTALL_PLAYWRIGHT_CHROMIUM})" ;; \
  esac

# Stable runtime boundary. Normal API source changes must not invalidate the
# OCR, production dependency, or Chromium layers above this point.
RUN mkdir -p /app/storage/photos \
  /app/storage/thumbnails \
  /app/storage/pdfs \
  /app/storage/pdf-pages \
  /app/storage/signage-rendered \
  /app/storage/assembly-procedure-images \
  /app/storage/measuring-instrument-genres \
  /app/storage/part-measurement-drawings \
  /app/storage/pallet-machine-illustrations \
  /app/storage/csv-dashboards \
  /app/storage/.integrity \
  && chown -R node:node /app/storage \
  && rm -rf /usr/local/lib/node_modules/npm

FROM api-runtime AS api

# build の dev node_modules は持ち込まない（--exclude=node_modules）。
COPY --from=build --exclude=node_modules /app/apps/api ./apps/api
COPY --from=build --exclude=node_modules /app/packages/shared-types ./packages/shared-types
COPY --from=build --exclude=node_modules /app/packages/part-search-core ./packages/part-search-core
COPY --from=build --exclude=node_modules /app/packages/shelf-layout-core ./packages/shelf-layout-core
COPY --from=build /app/scripts ./scripts

WORKDIR /app/apps/api
RUN nice -n 10 pnpm prisma generate
RUN rm -rf /root/.cache/node/corepack

# Release provenance is image metadata only. Keep it after every filesystem
# mutation so a new release SHA/config hash can reuse unchanged runtime layers.
ARG BUILD_COMMIT=unknown
ARG BUILD_CONFIG_HASH=unknown
LABEL org.opencontainers.image.revision=${BUILD_COMMIT}
LABEL org.opencontainers.image.config-hash=${BUILD_CONFIG_HASH}

ENV NODE_ENV=production
ENV HOME=/tmp/api-home
ENV XDG_CACHE_HOME=/tmp/api-cache
ENV DATABASE_URL="postgresql://postgres:postgres@db:5432/borrow_return"

USER node
CMD ["node", "dist/main.js"]
