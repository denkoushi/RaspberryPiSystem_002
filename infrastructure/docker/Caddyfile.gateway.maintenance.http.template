# HTTP-only fixed gateway maintenance page.
{
  auto_https off
}

:80 {
  @internal_backup_api path /api/backup/internal /api/backup/internal/*
  @internal_deploy_readiness path /api/system/deploy-readiness/internal

  route {
    respond @internal_backup_api 404
    respond @internal_deploy_readiness 404
    root * /srv/phase2-maintenance
    rewrite * /index.html
    file_server
  }
}
