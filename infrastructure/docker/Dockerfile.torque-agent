# syntax=docker/dockerfile:1
FROM python:3.14-slim AS builder
WORKDIR /build
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
RUN apt-get update && apt-get install -y --no-install-recommends build-essential libffi-dev && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir poetry
RUN python -m venv /opt/venv
ENV VIRTUAL_ENV="/opt/venv"
ENV PATH="/opt/venv/bin:$PATH"
COPY clients/torque-agent/pyproject.toml clients/torque-agent/poetry.lock ./
RUN poetry config virtualenvs.create false \
  && poetry install --only main --no-root --no-interaction
COPY clients/torque-agent/README.md ./README.md
COPY clients/torque-agent/torque_agent ./torque_agent
RUN poetry build --format wheel \
  && /opt/venv/bin/pip install --no-deps dist/*.whl \
  && python -m pip uninstall --yes pip setuptools wheel

FROM python:3.14-slim AS runtime
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PATH="/opt/venv/bin:$PATH"
RUN apt-get update \
  && apt-get install -y --only-upgrade --no-install-recommends \
    bsdutils \
    libblkid1 \
    liblastlog2-2 \
    libmount1 \
    libsmartcols1 \
    libuuid1 \
    login \
    mount \
    util-linux \
  && for package in bsdutils libblkid1 liblastlog2-2 libmount1 libsmartcols1 libuuid1 login mount util-linux; do \
    version="$(dpkg-query -W -f='${Version}' "$package")"; \
    dpkg --compare-versions "$version" ge '2.41.5-0+deb13u1' \
      || { echo "$package remains below the CVE-2026-53615 fixed version: $version" >&2; exit 1; }; \
  done \
  && rm -rf /var/lib/apt/lists/*
RUN python -m pip uninstall --yes pip setuptools wheel
COPY --from=builder /opt/venv /opt/venv
COPY clients/torque-agent ./torque-agent
WORKDIR /app/torque-agent
CMD ["python", "-m", "torque_agent"]
