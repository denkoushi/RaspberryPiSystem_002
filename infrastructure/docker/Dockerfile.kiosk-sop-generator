# syntax=docker/dockerfile:1
FROM node:24-trixie-slim@sha256:54f84b4cf8432b21aaffd5d3ce8d41e12cea0d10d33c09d2f3c9879d49d6b446 AS node-runtime
FROM mcr.microsoft.com/playwright:v1.64.1-noble@sha256:47b510dd9230bf0b9bfc9b20102241e577ea7a99334ab4c3ca19f19770e9b8ea

WORKDIR /workspace
ENV CI=true \
    TZ=Asia/Tokyo \
    LANG=ja_JP.UTF-8 \
    LC_ALL=ja_JP.UTF-8

COPY --from=node-runtime /usr/local/ /usr/local/
RUN node --version | grep -Eq '^v24\.'
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY patches ./patches
COPY infrastructure/docker/Dockerfile.kiosk-sop-generator infrastructure/docker/Dockerfile.kiosk-sop-generator
COPY apps/web/package.json apps/web/package.json
COPY packages/shared-types/package.json packages/shared-types/package.json
COPY packages/kiosk-sop-core/package.json packages/kiosk-sop-core/package.json
COPY packages/part-search-core/package.json packages/part-search-core/package.json
COPY packages/slip-match-core/package.json packages/slip-match-core/package.json
COPY packages/shelf-layout-core/package.json packages/shelf-layout-core/package.json
RUN --mount=type=cache,id=raspi-kiosk-sop-pnpm,target=/pnpm/store,sharing=locked \
    npm install -g "$(node -p "require('./package.json').packageManager")" \
    && pnpm install --frozen-lockfile --store-dir=/pnpm/store
COPY packages ./packages
RUN pnpm --filter @raspi-system/shared-types build \
    && pnpm --filter @raspi-system/kiosk-sop-core build \
    && pnpm --filter @raspi-system/part-search-core build \
    && pnpm --filter @raspi-system/slip-match-core build \
    && pnpm --filter @raspi-system/shelf-layout-core build
COPY apps/web ./apps/web
COPY e2e ./e2e
COPY playwright.kiosk-sop.config.ts ./playwright.kiosk-sop.config.ts
COPY scripts/kiosk-sop ./scripts/kiosk-sop
COPY scripts/ci/kiosk-sop-artifact-contract.mjs scripts/ci/kiosk-sop-artifact-contract.mjs
COPY scripts/ci/kiosk-sop-artifact-contract.test.mjs scripts/ci/kiosk-sop-artifact-contract.test.mjs
RUN mkdir -p docs/design-previews

CMD ["node", "scripts/kiosk-sop/generate.mjs", "check"]
