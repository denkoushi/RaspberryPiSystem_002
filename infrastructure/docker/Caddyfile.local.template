# ローカルネットワーク用Caddyfile（自己署名証明書使用）
# 工場現場での365日運用に最適

{
  # 自己署名証明書を使用するため、自動HTTPSを無効化
  auto_https off
}

# HTTPS設定（ポート443）
:443 {
  # 自己署名証明書のパスを指定
  tls /srv/certs/cert.pem /srv/certs/key.pem

  @internal_deploy_readiness path /api/system/deploy-readiness/internal
  respond @internal_deploy_readiness 404

  root * /srv/site

  @api {
    path /api/*
  }
  # APIプロキシ（通常HTTP）。WebSocketはCaddyが自動的にUpgradeを処理するため、
  # ここでUpgradeヘッダーを強制注入しない（通常HTTPが壊れるため）。
  reverse_proxy @api api:8080 {
    transport http {
      versions 1.1
    }
  }

  # 管理画面へのIP制限。ADMIN_ALLOW_NETS は標準リリース前に明示設定する。
  @admin_protect {
    path /admin*
    not remote_ip {$ADMIN_ALLOW_NETS}
  }
  respond @admin_protect "Forbidden" 403

  # 公開URLは維持しつつ、APIでSHA-256整合性を確認して配信する。
  handle /storage/thumbnails/* {
    uri replace /storage/thumbnails/ /api/storage/thumbnails/
    reverse_proxy api:8080
  }

  @static_site {
    not path /api/* /storage/*
  }
  route @static_site {
    @spa {
      not path /assets/*
      not file
    }
    rewrite @spa /index.html

    # HTMLは常に再検証し、配備前のentrypointから削除済みchunkを参照させない。
    @document path / /index.html
    header @document Cache-Control "no-store, no-cache, must-revalidate"

    @service_worker path /sw.js
    header @service_worker Cache-Control "no-cache"

    # Viteのcontent hash付きbundleは同名で内容が変わらない。public/assets由来の
    # hashなしファイルは既定の再検証のまま、存在しないchunkはキャッシュしない。
    @hashed_assets {
      path_regexp ^/assets/.+-[A-Za-z0-9_-]{8}\.(js|css|woff2?)$
      file
    }
    header @hashed_assets Cache-Control "public, max-age=31536000, immutable"

    # 静的ファイルだけ圧縮する。APIは自身のエンコードを維持する。
    encode zstd gzip
    file_server
  }

  # セキュリティヘッダー
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    X-XSS-Protection "1; mode=block"
    Referrer-Policy "strict-origin-when-cross-origin"
  }

  log {
    output file /var/log/caddy/access.log {
      roll_size 5MiB
      roll_keep 300
      roll_keep_for 168h
    }
  }
}

# HTTPからHTTPSへのリダイレクト（ポート80）
:80 {
  @internal_deploy_readiness path /api/system/deploy-readiness/internal
  respond @internal_deploy_readiness 404

  redir https://{host}{uri} permanent
}
