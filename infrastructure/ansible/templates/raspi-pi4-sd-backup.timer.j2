[Unit]
# Sunday midday, when the factory is idle. A long first off-site copy may overlap
# the 21:30 Pi5 DR snapshot; both only share Internet bandwidth.
Description=Weekly Pi4 SD-card backup

[Timer]
Unit={{ pi4_sd_backup_service_name }}
OnCalendar=Sun *-*-* 12:00:00 Asia/Tokyo
Persistent=false
AccuracySec=1s

[Install]
WantedBy=timers.target
