#!/bin/bash
set -euo pipefail

LOG_DIR="{{ trivy_log_dir }}"
LOG_FILE="${LOG_DIR}/trivy-image-scan.log"
mkdir -p "${LOG_DIR}"

# Run scans at the lowest CPU priority and cap their disk bandwidth so they do not starve the API/DB disk.
# ionice is ignored by mq-deadline, so the IO cap uses a cgroup v2 scope (io.max works with any scheduler).
LOW_PRIORITY=(nice -n 19)
if command -v systemd-run >/dev/null 2>&1 && [[ -d /run/systemd/system ]]; then
  LOW_PRIORITY=(systemd-run --scope --quiet --collect
    -p "IOReadBandwidthMax={{ security_scan_io_device | default('/') }} {{ security_scan_io_bandwidth_max | default('30M') }}"
    -p "IOWriteBandwidthMax={{ security_scan_io_device | default('/') }} {{ security_scan_io_bandwidth_max | default('30M') }}"
    nice -n 19)
fi

WEBHOOK_URL="${WEBHOOK_URL:-{{ alert_webhook_url | default('') }}}"
WEBHOOK_TIMEOUT_SECONDS="${WEBHOOK_TIMEOUT_SECONDS:-{{ alert_webhook_timeout_seconds | default(5) }}}"

TIMESTAMP="$(date +%Y-%m-%dT%H:%M:%S)"
echo "[$TIMESTAMP] Starting Trivy image scan..." >> "${LOG_FILE}"

# 稼働中のblue/greenおよび旧サービスからDockerイメージIDを取得する（リリースはタグを残さないため）。
IMAGES=()
IMAGE_TYPES=()
declare -A SEEN_IMAGES=()
for image_type in api web; do
  for service in "${image_type}-blue" "${image_type}-green" "${image_type}"; do
    while IFS= read -r image; do
      if [[ -z "${image}" || "${image}" == ":" ]]; then
        continue
      fi
      if [[ -z "${SEEN_IMAGES[${image}]:-}" ]]; then
        IMAGES+=("${image}")
        IMAGE_TYPES+=("${image_type}")
        SEEN_IMAGES["${image}"]=1
      fi
    done < <(docker ps --quiet --filter "label=com.docker.compose.service=${service}" 2>/dev/null \
      | xargs --no-run-if-empty docker inspect --format '{% raw %}{{.Image}}{% endraw %}' 2>/dev/null || true)
  done
done

if [[ {{ '${#' }}IMAGES[@]} -eq 0 ]]; then
  echo "[$TIMESTAMP] No Docker images found. Skipping image scan." >> "${LOG_FILE}"
  exit 0
fi

scan_image() {
  local image_name="$1"
  local image_type="$2"
  
  echo "[$TIMESTAMP] Scanning ${image_type} image: ${image_name}" >> "${LOG_FILE}"
  
  TRIVY_CMD=(/usr/bin/trivy image
    --severity HIGH,CRITICAL
    --ignore-unfixed
    --exit-code 5
    --timeout "{{ trivy_scan_timeout }}"
    --quiet
    --table-mode detailed
    "${image_name}"
  )
  
  set +e
  "${LOW_PRIORITY[@]}" "${TRIVY_CMD[@]}" >> "${LOG_FILE}" 2>&1
  TRIVY_EXIT=$?
  set -e
  
  if [[ ${TRIVY_EXIT} -eq 5 && -x "{{ alert_script_path }}" ]]; then
    RAW_DETAILS="$(grep -E '^(CRITICAL|HIGH):' -A5 "${LOG_FILE}" | tail -n 50)"
{% if trivy_alert_ignore_patterns %}
    FILTERED_DETAILS="${RAW_DETAILS}"
{% for ignore in trivy_alert_ignore_patterns %}
    FILTERED_DETAILS="$(echo "${FILTERED_DETAILS}" | grep -v "{{ ignore }}" || true)"
{% endfor %}
{% else %}
    FILTERED_DETAILS="${RAW_DETAILS}"
{% endif %}
    if [[ -n "${FILTERED_DETAILS}" ]]; then
      WEBHOOK_URL="${WEBHOOK_URL:-}" WEBHOOK_TIMEOUT_SECONDS="${WEBHOOK_TIMEOUT_SECONDS:-5}" \
        "{{ alert_script_path }}" \
          "trivy-image-detection" \
          "Trivyイメージスキャン（${image_type}）で脆弱性を検知しました" \
          "${FILTERED_DETAILS}"
    fi
  elif [[ ${TRIVY_EXIT} -ne 0 && ${TRIVY_EXIT} -ne 5 && -x "{{ alert_script_path }}" ]]; then
    WEBHOOK_URL="${WEBHOOK_URL:-}" WEBHOOK_TIMEOUT_SECONDS="${WEBHOOK_TIMEOUT_SECONDS:-5}" \
      "{{ alert_script_path }}" \
        "trivy-image-scan-error" \
        "Trivyイメージスキャン（${image_type}）でエラーが発生しました" \
        "詳細ログ: ${LOG_FILE}"
  fi
}

for index in "${!IMAGES[@]}"; do
  scan_image "${IMAGES[${index}]}" "${IMAGE_TYPES[${index}]}"
done

echo "[$(date +%Y-%m-%dT%H:%M:%S)] Trivy image scan completed." >> "${LOG_FILE}"
