[Unit]
Description=Backup verification (quarterly, integrity check)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
Environment=PROJECT_DIR={{ project_root }}
ExecStart={{ project_root }}/scripts/server/run-in-active-api.sh node /app/apps/api/dist/scripts/verify-backups.js --mode=quarterly --max-age-days={{ backup_verify_quarterly_max_age_days | default(110) }} --max-download-mb={{ backup_verify_max_download_mb | default(50) }}
StandardOutput=journal
StandardError=journal

