{# Dedicated business consultation Hermes. The guide instance remains unchanged. #}
model:
  default: {{ business_hermes_chat_model | to_json }}
  provider: custom:business-chat-dgx
  base_url: {{ business_hermes_chat_dgx_base_url | default('http://100.118.82.72:38081') }}/v1
  max_tokens: 1600
  api_mode: chat_completions

custom_providers:
  - name: business-chat-dgx
    base_url: {{ business_hermes_chat_dgx_base_url | default('http://100.118.82.72:38081') }}/v1
    key_env: BUSINESS_HERMES_CHAT_DGX_TOKEN
    extra_headers:
      X-LLM-Token: "${env:BUSINESS_HERMES_CHAT_DGX_TOKEN}"
    default_model: {{ business_hermes_chat_model | to_json }}

tools:
  # Keep MCP tools directly visible. The deferred search bridge adds latency and
  # hides the bounded business API surface from the consultation model.
  tool_search:
    enabled: "off"

memory:
  memory_enabled: false
  user_profile_enabled: false

mcp_servers:
  business_api:
    url: "{{ business_hermes_chat_mcp_url | default('https://gateway/api/internal/business-hermes/mcp') }}"
    headers:
      Authorization: "Bearer ${env:BUSINESS_HERMES_MCP_API_KEY}"
    # The internal gateway uses the existing Pi5 deployment certificate. The
    # request stays on the private Docker bridge and follows active Caddy
    # routing; no public CA trust is required for this hop.
    ssl_verify: false
    timeout: 120
    connect_timeout: 10

agent:
  max_turns: 12
  reasoning_effort: medium
  system_prompt: |
    目的を理解してから、必要な読み取り専用の業務APIツールを選び、結果を確認する。候補と相違点を説明できたら短く止め、次の判断に必要な確認を一つだけ尋ねる。複数件の一覧依頼では各件を識別子と要点一文で簡潔に示し、処置・是正の詳細は利用者がその内容を求める次の操作で提示する。明示された詳細依頼には必要な範囲で答える。工程や症状からの原因判断は記録された事実の範囲で扱い、現在の作業手順を求められたときは公開作業要領を確認する。正本の事実と推測を分け、訂正された前提を反映する。SOUL.md、作業ディレクトリのAGENTS.md、skills/business-consultation/SKILL.mdはHermes標準のコンテキスト／Skill読み込み経路で適用する。
  disabled_toolsets:
    - memory
    - session_search
    - browser
    - code_execution
    - cronjob
    - delegation
    - file
    - image_gen
    - terminal
    - todo
    - vision
    - web
    - messaging
    - kanban
    - discord
    - computer_use

skills:
  # Official Hermes write gate: skill_manage may be visible for standard Skill
  # loading, but every mutation is staged and requires an explicit approval.
  write_approval: true

curator:
  enabled: false

platform_toolsets:
  api_server:
    - business_api
    - skills

terminal:
  backend: local
  cwd: /opt/data/home
  home_mode: profile
  env_passthrough: []

gateway:
  api_server:
    enabled: true
    host: 0.0.0.0
    port: 8642
    model_name: business-hermes-chat
    max_concurrent_runs: 2
