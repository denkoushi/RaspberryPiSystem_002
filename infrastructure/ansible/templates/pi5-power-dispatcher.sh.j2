#!/usr/bin/env bash
# Handle request failures explicitly: errexit must not interrupt the queue.
set -uo pipefail

TRIGGER_PATH="${1:-}"
REPO_ROOT="{{ repo_path | default('/opt/RaspberryPiSystem_002') }}"
INVENTORY="{{ pi5_ansible_inventory | default((repo_path | default('/opt/RaspberryPiSystem_002')) ~ '/infrastructure/ansible/inventory.yml') }}"
ANSIBLE_DIR="${REPO_ROOT}/infrastructure/ansible"
PLAYBOOK="${ANSIBLE_DIR}/playbooks/power-control.yml"
LOG_DIR="${REPO_ROOT}/logs/power-actions"
QUEUE_DIR="${REPO_ROOT}/power-actions"
PROCESSED_DIR="${QUEUE_DIR}/processed"
FAILED_DIR="${QUEUE_DIR}/failed"
DEBUG_LOG="${LOG_DIR}/dispatcher-debug.log"

mkdir -p "${LOG_DIR}" "${PROCESSED_DIR}" "${FAILED_DIR}" || exit 1
TRIGGER_PATH="${TRIGGER_PATH:-${QUEUE_DIR}}"

# Globbing under the C locale gives timestamp/name order, also on bash 3.2.
export LC_ALL=C
shopt -s nullglob
QUEUE_FILES=()
if [[ -d "${TRIGGER_PATH}" ]]; then
  for file in "${TRIGGER_PATH}"/*.json; do
    [[ -f "${file}" ]] && QUEUE_FILES+=("${file}")
  done
elif [[ -f "${TRIGGER_PATH}" ]]; then
  QUEUE_FILES=("${TRIGGER_PATH}")
fi

for QUEUE_FILE in ${QUEUE_FILES[@]+"${QUEUE_FILES[@]}"}; do
  if [[ "${QUEUE_FILE}" == "${PROCESSED_DIR}"/* ]] || [[ "${QUEUE_FILE}" == "${FAILED_DIR}"/* ]]; then
    continue
  fi
  # Normalize before changing directory so the Ansible request path is absolute.
  case "${QUEUE_FILE}" in
    /*) ;;
    *) QUEUE_FILE="${PWD}/${QUEUE_FILE}" ;;
  esac
  NAME="${QUEUE_FILE##*/}"
  ACTION=""
  OUTCOME="invalid"
  METADATA='{"clientDeviceId":null,"requestId":null,"action":null}'
  if PARSED=$(python3 - "${QUEUE_FILE}" "${POWER_ACTION_MAX_AGE_SECONDS:-300}" <<'PY'
import datetime
import json
import math
import sys

metadata = {"clientDeviceId": None, "requestId": None, "action": None}
action = ""
outcome = "invalid"
try:
    with open(sys.argv[1], encoding="utf-8") as stream:
        data = json.load(stream)
    if isinstance(data, dict):
        metadata = {field: data.get(field) for field in metadata}
        if data.get("action") in ("reboot", "poweroff"):
            action = data["action"]
            outcome = "expired age=unknown"
            try:
                requested = datetime.datetime.fromisoformat(data["requestedAt"].replace("Z", "+00:00"))
                if requested.tzinfo is None:
                    raise ValueError("timezone required")
                age = (datetime.datetime.now(datetime.timezone.utc) - requested).total_seconds()
                max_age = float(sys.argv[2])
                if not math.isfinite(max_age) or max_age < 0:
                    raise ValueError("invalid max age")
                outcome = "expired age={}s".format(int(age))
                if -60 <= age <= max_age:
                    outcome = "ready"
            except (KeyError, AttributeError, TypeError, ValueError, OverflowError):
                pass
except (OSError, ValueError, TypeError):
    pass
print(action)
print(outcome)
print(json.dumps(metadata, ensure_ascii=True))
PY
  ); then
    ACTION="${PARSED%%$'\n'*}"
    PARSED="${PARSED#*$'\n'}"
    OUTCOME="${PARSED%%$'\n'*}"
    METADATA="${PARSED#*$'\n'}"
  fi

  DESTINATION="${FAILED_DIR}/${NAME}"
  case "${OUTCOME}" in
    expired*) DESTINATION="${DESTINATION}.expired" ;;
    ready)
      # The queue file name contains the client key, so hand Ansible a private copy
      # under a neutral name; the key must not appear on a command line.
      # Stabilize relative paths in ansible.cfg; failures still retire this request.
      if REQUEST_COPY=$(mktemp "${TMPDIR:-/tmp}/power-request.XXXXXX") && \
        cp -- "${QUEUE_FILE}" "${REQUEST_COPY}" && \
        (cd "${ANSIBLE_DIR}" && \
        ANSIBLE_CONFIG="${ANSIBLE_DIR}/ansible.cfg" ANSIBLE_ROLES_PATH="${ANSIBLE_DIR}/roles" \
        ansible-playbook "${PLAYBOOK}" -i "${INVENTORY}" \
          -e "power_action=${ACTION}" -e "power_request_file=${REQUEST_COPY}") \
          >> "${LOG_DIR}/${NAME}.log" 2>&1; then
        OUTCOME="processed"
        DESTINATION="${PROCESSED_DIR}/${NAME}"
      else
        rc=$?
        OUTCOME="failed rc=${rc}"
      fi
      rm -f -- "${REQUEST_COPY:-}"
      ;;
  esac
  if ! mv -- "${QUEUE_FILE}" "${DESTINATION}"; then
    OUTCOME="failed rc=1"
    mv -- "${QUEUE_FILE}" "${FAILED_DIR}/${NAME}" || true
  fi
  printf '%s %s %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "${METADATA}" "${OUTCOME}" \
    >> "${DEBUG_LOG}" 2>/dev/null || true
done
exit 0
