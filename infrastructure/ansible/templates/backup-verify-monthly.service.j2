[Unit]
Description=Backup verification (monthly, non-destructive)
OnFailure=backup-verify-alert@backup-verify-monthly.service
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
Environment=PROJECT_DIR={{ project_root }}
ExecStart={{ project_root }}/scripts/server/run-in-active-api.sh node /app/apps/api/dist/scripts/verify-backups.js --mode=monthly --max-age-days={{ backup_verify_monthly_max_age_days | default(35) }} --max-download-mb={{ backup_verify_max_download_mb | default(50) }}
StandardOutput=journal
StandardError=journal

