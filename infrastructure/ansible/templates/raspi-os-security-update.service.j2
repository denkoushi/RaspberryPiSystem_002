[Unit]
Description=Weekly Raspberry Pi OS security updates
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# Some kiosks use a non-UTF-8 system locale; keep tool output and logs UTF-8.
Environment=LC_ALL=C.UTF-8 LANG=C.UTF-8 LANGUAGE=
ExecStart=/usr/local/sbin/raspi-os-security-update
TimeoutStartSec=2h
Nice=10
IOSchedulingClass=idle
StandardOutput=journal
StandardError=journal
