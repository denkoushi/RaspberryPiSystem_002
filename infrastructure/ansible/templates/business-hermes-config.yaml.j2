{# Business Hermes single-purpose assembly-guide configuration. #}
{# Keep credentials in the runtime env; this file only references their names. #}
model:
  # Gateway startup reads model.default directly, before its env expansion
  # helper. Render the selected model as a concrete YAML scalar.
  default: {{ business_hermes_model | to_json }}
  max_tokens: 512
  api_mode: chat_completions

providers:
  business-dgx:
    name: business-dgx
    base_url: http://100.118.82.72:38081/v1
    key_env: BUSINESS_HERMES_DGX_TOKEN
    extra_headers:
      X-LLM-Token: "${env:BUSINESS_HERMES_DGX_TOKEN}"
    api_mode: chat_completions
    discover_models: false
  business-openai:
    name: business-openai
    base_url: https://api.openai.com/v1
    key_env: BUSINESS_HERMES_OPENAI_API_KEY
    api_mode: chat_completions
    discover_models: false

memory:
  memory_enabled: false
  user_profile_enabled: false

agent:
  reasoning_effort: xhigh
  disabled_toolsets:
    - skills
    - memory
    - session_search
    - browser
    - code_execution
    - cronjob
    - delegation
    - file
    - image_gen
    - terminal
    - todo
    - vision
    - web

terminal:
  backend: local
  cwd: /opt/data/home
  home_mode: profile
  env_passthrough: []

gateway:
  api_server:
    enabled: true
    host: 0.0.0.0
    port: 8642
    model_name: business-hermes
    max_concurrent_runs: 2
