# Non-secret runtime settings for the Business Pi5 Google Drive DR runner.
# OAuth material and the restic password are pre-provisioned separately and
# are referenced by path only; do not put secret values in this file.
BUSINESS_PI5_PROJECT_ROOT={{ google_drive_dr_project_root }}
BUSINESS_PI5_DR_CREDENTIAL_ROOT={{ google_drive_dr_credential_root }}
BACKUP_STAGING_ROOT={{ google_drive_dr_staging_root }}
RESTIC_REPOSITORY={{ google_drive_dr_repository }}
RCLONE_CONFIG={{ google_drive_dr_rclone_config }}
RESTIC_PASSWORD_FILE={{ google_drive_dr_restic_password_file }}
BUSINESS_PI5_COMPOSE_FILE={{ google_drive_dr_project_root }}/infrastructure/docker/docker-compose.server.yml
