# fail2ban / ClamAV logs use package-owned rotation; omit duplicates instead of
# overriding package definitions to enforce the former rotate 52 retention.

/var/log/trivy/*.log {
    weekly
    rotate 52
    missingok
    compress
    delaycompress
    notifempty
}

{{ package_integrity_log_dir | default('/var/log/package-integrity') }}/*.log {
    weekly
    rotate 52
    missingok
    compress
    delaycompress
    notifempty
}

{{ repo_path | default('/opt/RaspberryPiSystem_002') }}/alerts/*.json {
    weekly
    rotate 26
    missingok
    compress
    delaycompress
    notifempty
}
