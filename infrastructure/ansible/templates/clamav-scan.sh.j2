#!/bin/bash
set -euo pipefail

LOG_DIR="{{ clamav_log_dir }}"
LOG_FILE="${LOG_DIR}/{{ clamav_log_file }}"
mkdir -p "${LOG_DIR}"

# Run scans at the lowest CPU priority and cap their disk bandwidth so they do not starve the API/DB disk.
# ionice is ignored by mq-deadline, so the IO cap uses a cgroup v2 scope (io.max works with any scheduler).
LOW_PRIORITY=(nice -n 19)
if command -v systemd-run >/dev/null 2>&1 && [[ -d /run/systemd/system ]]; then
  LOW_PRIORITY=(systemd-run --scope --quiet --collect
    -p "IOReadBandwidthMax={{ security_scan_io_device | default('/') }} {{ security_scan_io_bandwidth_max | default('30M') }}"
    -p "IOWriteBandwidthMax={{ security_scan_io_device | default('/') }} {{ security_scan_io_bandwidth_max | default('30M') }}"
    nice -n 19)
fi

SCAN_TARGETS=(
{% for path in clamav_scan_paths %}
"{{ path }}"
{% endfor %}
)

TIMESTAMP="$(date +%Y-%m-%dT%H:%M:%S)"
echo "[$TIMESTAMP] Starting ClamAV scan..." >> "${LOG_FILE}"

{% if clamav_update_before_scan | default(false) %}
set +e
"${LOW_PRIORITY[@]}" timeout 15m freshclam --quiet >> "${LOG_FILE}" 2>&1
UPDATE_EXIT=$?
set -e
if [[ ${UPDATE_EXIT} -ne 0 ]]; then
  echo "[$(date +%Y-%m-%dT%H:%M:%S)] Virus database update failed (exit ${UPDATE_EXIT}); scanning with the existing database." >> "${LOG_FILE}"
fi

EXISTING_TARGETS=()
for path in "${SCAN_TARGETS[@]}"; do
  if [[ -e "${path}" ]]; then
    EXISTING_TARGETS+=("${path}")
  else
    echo "[$(date +%Y-%m-%dT%H:%M:%S)] Skipping missing scan path: ${path}" >> "${LOG_FILE}"
  fi
done
if [[ {{ '${#' }}EXISTING_TARGETS[@]} -eq 0 ]]; then
  echo "[$(date +%Y-%m-%dT%H:%M:%S)] No existing scan paths; scan cannot run." >> "${LOG_FILE}"
  SCAN_EXIT=2
else
  SCAN_TARGETS=("${EXISTING_TARGETS[@]}")
{% endif %}
set +e
"${LOW_PRIORITY[@]}" /usr/bin/clamscan \
  --recursive \
  --infected \
  --quiet \
  --max-filesize=200M \
  --max-scansize=400M \
  "${SCAN_TARGETS[@]}" >> "${LOG_FILE}" 2>&1
SCAN_EXIT=$?
set -e
{% if clamav_update_before_scan | default(false) %}
fi
{% endif %}

echo "[$(date +%Y-%m-%dT%H:%M:%S)] Scan completed." >> "${LOG_FILE}"

if [[ ${SCAN_EXIT} -eq 1 && -x "{{ alert_script_path }}" ]]; then
  DETAILS="$(grep -E 'FOUND' "${LOG_FILE}" | tail -n 20)"
  DETAILS=${DETAILS:-"ClamAV reported infected files. See ${LOG_FILE} for details."}
  "{{ alert_script_path }}" \
    "clamav-detection" \
    "ClamAVスキャンで感染ファイルを検知しました" \
    "${DETAILS}"
elif [[ ${SCAN_EXIT} -gt 1 && -x "{{ alert_script_path }}" ]]; then
  "{{ alert_script_path }}" \
    "clamav-scan-error" \
    "ClamAVスキャンでエラーが発生しました" \
    "詳細ログ: ${LOG_FILE}"
fi
