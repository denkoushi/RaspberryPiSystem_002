[Unit]
Description=Raspberry Pi Status Agent
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Environment=STATUS_AGENT_CONFIG=/etc/raspi-status-agent.conf
ExecStartPre=-+/bin/sh -c 'umask 022; v=$$(/usr/bin/vcgencmd get_throttled) && printf "%%s %%s" "$$(date +%%s)" "$$v" > /run/raspi-status-agent-throttled.tmp && mv -f /run/raspi-status-agent-throttled.tmp /run/raspi-status-agent-throttled'
ExecStart=/usr/local/bin/raspi-signage-status-agent.pyz
User=raspi-status-agent
Group=raspi-status-agent
SupplementaryGroups=systemd-journal video
StateDirectory=raspi-os-security-update/requests
RuntimeDirectory=raspi-status-agent
RuntimeDirectoryPreserve=yes
Nice=5

[Install]
WantedBy=multi-user.target
