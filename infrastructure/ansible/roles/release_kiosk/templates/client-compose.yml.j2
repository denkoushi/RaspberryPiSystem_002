services:
{% if 'nfc-agent' in release_kiosk_services %}
  nfc-agent:
    image: {{ release_kiosk_compose_images['nfc-agent'] | to_json }}
    network_mode: host
    user: "10001:10001"
    security_opt: ["no-new-privileges:true"]
    cap_drop: ["ALL"]
    # No cap_add: PC/SC, libusb and evdev need no capabilities (including SYS_RAWIO).
    group_add: ["46", "104"]
    device_cgroup_rules:
      - "c 189:* rw"
      - "c 13:* rw"
    env_file:
      - {{ (release_kiosk_project_dir ~ '/clients/nfc-agent/.env') | to_json }}
    volumes:
      - nfc-agent-data:/data
      # Preserve the relative queue default, including previous images on rollback.
      - nfc-agent-data:/app/nfc-agent/data
      - /run/pcscd:/run/pcscd:ro
      - /dev/bus/usb:/dev/bus/usb:ro
      - /dev/input:/dev/input:ro
    restart: unless-stopped
{% endif %}
{% if 'barcode-agent' in release_kiosk_services %}
  barcode-agent:
    image: {{ release_kiosk_compose_images['barcode-agent'] | to_json }}
    network_mode: host
    user: "10001:10001"
    security_opt: ["no-new-privileges:true"]
    cap_drop: ["ALL"]
    # No cap_add: Serial open/ioctl needs no capabilities; dialout grants device access.
    group_add: ["20"]
    device_cgroup_rules:
      - "c 166:* rw"
      - "c 188:* rw"
    env_file:
      - {{ (release_kiosk_project_dir ~ '/clients/barcode-agent/.env') | to_json }}
    # ttyACM/ttyUSB nodes live directly in /dev; a parent bind survives hotplug.
    # Read-only prevents directory changes; cgroups allow only serial device I/O.
    volumes:
      - /dev:/dev:ro
    restart: unless-stopped
{% endif %}
{% if 'torque-agent' in release_kiosk_services %}
  torque-agent:
    image: {{ release_kiosk_compose_images['torque-agent'] | to_json }}
    network_mode: host
    user: "10001:10001"
    security_opt: ["no-new-privileges:true"]
    cap_drop: ["ALL"]
    # No cap_add: Evdev read/grab needs no capabilities; input grants device access.
    group_add: ["104"]
    device_cgroup_rules:
      - "c 13:* rw"
    env_file:
      - {{ (release_kiosk_project_dir ~ '/clients/torque-agent/.env') | to_json }}
    volumes:
      - torque-agent-data:/data
      - /dev/input:/dev/input:ro
      - /run/torque-bluetooth-guard:/run/torque-bluetooth-guard
    healthcheck:
      test: [CMD, python, -c, "import json,urllib.request; data=json.load(urllib.request.urlopen('http://127.0.0.1:7073/health', timeout=3)); assert data.get('ok') is True"]
      interval: 15s
      timeout: 5s
      retries: 3
      start_period: 10s
    restart: unless-stopped
{% endif %}

volumes:
{% if 'nfc-agent' in release_kiosk_services %}
  nfc-agent-data:
{% endif %}
{% if 'torque-agent' in release_kiosk_services %}
  torque-agent-data:
{% endif %}
