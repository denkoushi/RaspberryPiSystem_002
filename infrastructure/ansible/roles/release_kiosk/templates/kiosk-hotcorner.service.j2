[Unit]
Description=Kiosk top-left corner panel sensor
# Order after graphical.target explicitly, like kiosk-browser.service. Without it
# graphical.target is implicitly ordered after this unit, which with
# kiosk-browser's After=graphical.target forms a cycle and systemd drops the
# start job at boot.
After=graphical.target kiosk-browser.service
Wants=graphical.target

[Service]
Type=simple
User={{ ansible_user }}
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/{{ ansible_user }}/.Xauthority
Environment=XDG_RUNTIME_DIR=/run/user/{{ release_kiosk_user_uid.stdout }}
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/{{ release_kiosk_user_uid.stdout }}/bus
ExecStart=/usr/bin/python3 /usr/local/bin/kiosk-hotcorner.py
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
