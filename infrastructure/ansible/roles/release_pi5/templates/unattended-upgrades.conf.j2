// Managed by Ansible (release_pi5). Preserve vendor and local APT files.
// APT appends lists: clear both origin mechanisms to exclude the base suite
// allowed by Debian's 50unattended-upgrades and any earlier legacy entries.
#clear Unattended-Upgrade::Allowed-Origins;
#clear Unattended-Upgrade::Origins-Pattern;
Unattended-Upgrade::Origins-Pattern {
    "origin=Debian,codename=${distro_codename}-security,label=Debian-Security";
};

// These are Python regular expressions, not shell package globs.
// Append to any existing local exclusions rather than removing them.
Unattended-Upgrade::Package-Blacklist {
{% for pattern in unattended_upgrades_package_blacklist %}
    "{{ pattern }}";
{% endfor %}
};

Unattended-Upgrade::Automatic-Reboot "false";
// Keep kernel packages for the separately scheduled manual maintenance.
Unattended-Upgrade::Remove-Unused-Kernel-Packages "false";

{% set periodic_enabled = '1' if unattended_upgrades_enabled | bool else '0' %}
APT::Periodic::Update-Package-Lists "{{ periodic_enabled }}";
APT::Periodic::Unattended-Upgrade "{{ periodic_enabled }}";
APT::Periodic::AutocleanInterval "{{ '7' if unattended_upgrades_enabled | bool else '0' }}";

Dpkg::Options {
    "--force-confdef";
    "--force-confold";
};
