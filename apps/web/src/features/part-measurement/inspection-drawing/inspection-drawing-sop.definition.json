              "id": "add-point",
              "targetId": "add-point",
              "necessity": "optional",
              "title": "測定点を追加",
              "description": "追加モードで図面上の測定位置を押します。"
            },
            {
              "id": "place-callout",
              "targetId": "place-callout",
              "necessity": "optional",
              "title": "引出線の先端を置く",
              "description": "対象の場合、番号から測定箇所への先端を指定します。"
            },
            {
              "id": "select-point-list",
              "targetId": "point-list",
              "necessity": "required",
              "title": "点一覧で確認",
              "description": "登録順と入力不足の点を右側一覧で確認します。"
            },
            {
              "id": "delete-one-point",
              "targetId": "delete-one-point",
              "necessity": "optional",
              "title": "選択点を削除",
              "description": "不要な点だけを削除します。"
            },
            {
              "id": "delete-all-points",
              "targetId": "delete-all-points",
              "necessity": "optional",
              "title": "全点を削除",
              "description": "図面を作り直す場合だけ全点削除します。"
            }
          ]
