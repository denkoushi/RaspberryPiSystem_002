        "width": 1536,
        "height": 864,
        "deviceScaleFactor": 1
      },
      "sheets": [
        {
          "id": "edit-basics",
          "title": "基本情報と図面を確認する",
          "summary": "改版対象、図面、工程、自主検査条件を確認してから編集します。",
          "steps": [
            {
              "id": "confirm-template-meta",
              "targetId": "template-metadata",
              "necessity": "required",
              "title": "対象情報を確認",
              "description": "品番・工程・資源CD・版が正しいことを確認します。"
            },
            {
              "id": "open-visual-source",
              "targetId": "open-visual-source",
              "necessity": "optional",
              "title": "図面ソースを開く",
              "description": "図面を差し替える場合に図面ソース選択を開きます。"
            },
            {
              "id": "set-self-inspection",
              "targetId": "self-inspection-setting",
              "necessity": "required",
              "title": "自主検査条件を確認",
              "description": "全数または指定数と検査数を設定します。"
            },
            {
              "id": "save-revision",
              "targetId": "save-revision",
              "necessity": "required",
              "title": "改版を保存",
              "description": "入力条件を満たした後に新しい版として保存します。"
            }
          ]
        },
        {
          "id": "edit-visual-source",
          "title": "図面ソースを選ぶ",
          "summary": "登録済み図面または新しいファイルから使用する図面を選びます。",
          "steps": [
            {
              "id": "pick-existing-visual",
              "targetId": "pick-existing-visual",
              "necessity": "optional",
              "title": "登録済み図面を選ぶ",
