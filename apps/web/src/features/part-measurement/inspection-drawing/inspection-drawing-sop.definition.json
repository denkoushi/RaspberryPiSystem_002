              "id": "open-test-input",
              "targetId": "test-input",
              "necessity": "optional",
              "title": "テスト入力",
              "description": "測定値入力と合否表示を保存前に確認します。"
            },
            {
              "id": "open-guided-trial",
              "targetId": "guided-trial",
              "necessity": "optional",
              "title": "ガイド試行",
              "description": "画面案内に沿って測定順を確認します。"
            },
            {
              "id": "zoom-drawing",
              "targetId": "zoom-drawing",
              "necessity": "optional",
              "title": "図面を拡大・縮小",
              "description": "細部を確認し、表示を全体へ戻せます。"
            },
            {
              "id": "open-saved-report",
              "targetId": "saved-report",
              "necessity": "optional",
              "title": "保存済み帳票",
              "description": "現在版の印刷レイアウトを確認します。"
            },
            {
              "id": "return-library",
              "targetId": "return-library",
              "necessity": "required",
              "title": "一覧に戻る",
              "description": "保存状態を確認して検査図面一覧へ戻ります。"
            }
          ]
        },
        {
          "id": "edit-group-history",
          "title": "資源グループと履歴版を扱う",
          "summary": "兄弟資源をまとめて改版する場合と、履歴版を復帰する場合の操作です。",
          "steps": [
            {
              "id": "choose-group-save",
              "targetId": "group-save",
              "necessity": "optional",
              "title": "まとめて改版を選ぶ",
              "description": "対象の場合、兄弟資源すべてへ同じ改版を反映します。"
            },
            {
              "id": "choose-single-save",
              "targetId": "single-save",
              "necessity": "optional",
              "title": "この資源だけ改版",
              "description": "対象資源だけを兄弟グループから切り離して改版します。"
            },
            {
              "id": "add-group-resource",
              "targetId": "add-group-resource",
              "necessity": "optional",
              "title": "資源を追加",
              "description": "対象の場合、同じ図面を使う資源CDを追加します。"
            },
            {
              "id": "activate-history",
              "targetId": "activate-history",
              "necessity": "optional",
              "title": "履歴版を有効化",
              "description": "履歴画面で対象版を選び、有効版として復帰します。"
            },
            {
              "id": "confirm-save-scope",
              "targetId": "save-scope-warning",
              "necessity": "required",
              "title": "保存範囲を確認",
              "description": "保存前に対象資源と警告内容を必ず確認します。"
            }
          ]
        }
