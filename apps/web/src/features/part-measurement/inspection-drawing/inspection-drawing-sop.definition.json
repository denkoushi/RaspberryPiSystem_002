{
  "schemaVersion": 1,
  "id": "inspection-drawing",
  "title": "検査図面 操作取説",
  "entrySources": [
    "apps/web/src/pages/kiosk/KioskInspectionDrawingLibraryPage.tsx",
    "apps/web/src/pages/kiosk/KioskInspectionDrawingCreatePage.tsx"
  ],
  "supplementalWatchGlobs": [
    "apps/web/src/features/part-measurement/inspection-drawing/**",
    "apps/web/src/features/kiosk-sop/**",
    "apps/web/src/components/ui/**",
    "apps/web/src/layouts/KioskLayout.tsx",
    "apps/web/src/index.css",
    "apps/web/tailwind.config.*",
    "scripts/kiosk-sop/**",
    "packages/kiosk-sop-core/src/**"
  ],
  "exclusions": [
    {
      "id": "viewer-close",
      "reason": "取説ビューアー共通の閉じる操作"
    },
    {
      "id": "manual-launcher",
      "reason": "取説を開くための共通操作であり取説本文の対象外"
    },
    {
      "id": "native-file-picker",
      "reason": "OS標準ファイル選択ダイアログ内の操作"
    }
  ],
  "scenarios": [
    {
      "id": "library",
      "productionRoute": "/kiosk/part-measurement/inspection",
      "fixtureId": "inspection-drawing-library-v1",
      "viewport": {
        "width": 1280,
        "height": 800,
        "deviceScaleFactor": 1
      },
      "sheets": [
        {
          "id": "library-entry-search",
          "title": "一覧を開いて対象を探す",
          "summary": "検査図面へ移動し、数字・品番・図面名・資源で対象を絞ります。",
          "steps": [
            {
              "id": "open-inspection-drawing",
              "targetId": "inspection-navigation",
              "necessity": "required",
              "title": "検査図面を開く",
              "description": "キオスク上部の検査図面を選びます。"
            },
            {
              "id": "search-drawing-digits",
              "targetId": "drawing-digit-search",
              "necessity": "optional",
              "title": "図面番号の数字で検索",
              "description": "図面名に含まれる数字をテンキーから入力します。"
            },
            {
              "id": "filter-part-number",
              "targetId": "part-number-filter",
              "necessity": "optional",
              "title": "品番で絞る",
              "description": "品番の一部を入力して候補を減らします。"
            },
            {
              "id": "filter-resource",
              "targetId": "resource-filter",
              "necessity": "optional",
              "title": "資源で絞る",
              "description": "加工する資源CDを選びます。"
            },
            {
              "id": "reload-library",
              "targetId": "reload-library",
              "necessity": "optional",
              "title": "最新状態を再読込",
              "description": "登録・改版後に一覧を最新化します。"
            }
          ]
        },
        {
          "id": "library-visual-management",
          "title": "表示図面を管理する",
          "summary": "図面画像を登録し、名称変更または図面からテンプレートを作成します。",
          "steps": [
            {
              "id": "register-visual",
              "targetId": "register-visual",
              "necessity": "optional",
              "title": "図面を登録",
              "description": "PNGまたはPDFを表示図面として登録します。"
            },
            {
              "id": "search-visual-name",
              "targetId": "visual-name-search",
              "necessity": "optional",
              "title": "図面名で検索",
              "description": "登録済み表示図面を名称で絞ります。"
            },
            {
              "id": "rename-visual",
              "targetId": "rename-visual",
              "necessity": "optional",
              "title": "図面名を変更",
              "description": "現場で識別しやすい名称へ変更します。"
            },
            {
              "id": "create-from-visual",
              "targetId": "create-from-visual",
              "necessity": "required",
              "title": "新規テンプレートを作る",
              "description": "選んだ図面を使って測定点を登録します。"
            }
          ]
        },
        {
          "id": "library-template-management",
          "title": "テンプレートを選択・管理する",
          "summary": "既存版の編集、履歴確認、帳票表示、無効化を行います。",
          "steps": [
            {
              "id": "edit-template",
              "targetId": "edit-template",
              "necessity": "required",
              "title": "編集を開く",
              "description": "対象行の編集を押して現在の有効版を開きます。"
            },
            {
              "id": "open-report",
              "targetId": "open-report",
              "necessity": "optional",
              "title": "帳票を表示",
              "description": "保存済みテンプレートの印刷用帳票を確認します。"
            },
            {
              "id": "open-history",
              "targetId": "open-history",
              "necessity": "optional",
              "title": "履歴を確認",
              "description": "過去版と現在の有効版を確認します。"
            },
            {
              "id": "include-inactive",
              "targetId": "include-inactive",
              "necessity": "optional",
              "title": "無効版を含める",
              "description": "無効化済みテンプレートも一覧に表示します。"
            },
            {
              "id": "retire-template",
              "targetId": "retire-template",
              "necessity": "optional",
              "title": "テンプレートを無効化",
              "description": "使用を止める有効版だけを無効化します。"
            }
          ]
        }
      ]
    },
    {
