              "necessity": "optional",
              "title": "表示文字を直接入力",
              "description": "自動表記で不足する場合だけ直接入力します。"
            },
            {
              "id": "use-ocr-candidate",
              "targetId": "ocr-candidate",
              "necessity": "optional",
              "title": "OCR候補を使う",
              "description": "図面から抽出された値を確認して適用します。"
            }
          ]
